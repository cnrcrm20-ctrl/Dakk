{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in Dakk Messenger",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "email", "createdAt", "updatedAt"]
    },
    "Contact": {
      "title": "Contact",
      "description": "User saved contact",
      "type": "object",
      "properties": {
        "contactUserId": { "type": "string" },
        "alias": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string", "format": "date-time" },
        "isBlocked": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["contactUserId", "alias", "createdAt", "updatedAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Chat metadata between members",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "memberUids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lastMessage": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "lastMessageTimestamp": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["memberUids", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message in a chat",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "deliveryStatus": { "type": "string", "enum": ["SENT", "DELIVERED", "READ"] },
        "messageType": { "type": "string", "enum": ["TEXT", "AUDIO", "IMAGE"] },
        "mediaUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "senderId", "senderName", "content", "deliveryStatus", "messageType", "createdAt"]
    },
    "Rendezvous": {
      "title": "Rendezvous",
      "description": "Realtime signaling and friend request handshake room",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "recipientUid": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "ACCEPTED", "REJECTED"] },
        "signalOffer": { "type": "string" },
        "signalAnswer": { "type": "string" },
        "iceCandidates": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection"
    },
    "/users/{userId}/contacts/{contactUserId}": {
      "schema": "Contact",
      "description": "User saved contacts subcollection"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Conversations collection"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Individual messages subcollection inside chat"
    },
    "/rendezvous/{roomId}": {
      "schema": "Rendezvous",
      "description": "Signal and handshake rendezvous collection"
    }
  }
}
