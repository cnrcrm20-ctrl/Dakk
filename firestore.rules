rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFounder() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email in ['kurucu1@example.com', 'kurucu2@example.com'];
    }

    function isChatMember(chatId) {
      return isSignedIn() &&
             request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids;
    }

    function isValidUserProfile(data) {
      return data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.email is string && data.email.size() <= 120 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 100)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidContact(data) {
      return data.contactUserId is string && data.contactUserId.size() >= 1 &&
             data.alias is string && data.alias.size() <= 60 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 1000)) &&
             (!('lastMessageTime' in data) || (data.lastMessageTime is timestamp && data.lastMessageTime <= request.time)) &&
             (!('isBlocked' in data) || data.isBlocked is bool) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChat(data) {
      return data.memberUids is list && data.memberUids.size() >= 2 && data.memberUids.size() <= 50 &&
             request.auth.uid in data.memberUids &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 1000)) &&
             (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string)) &&
             (!('lastMessageTimestamp' in data) || (data.lastMessageTimestamp is timestamp && data.lastMessageTimestamp <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatMessage(data) {
      return data.chatId is string && data.chatId.size() >= 1 &&
             data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() <= 60 &&
             data.content is string && data.content.size() <= 5000 &&
             data.deliveryStatus is string && (data.deliveryStatus in ['SENT', 'DELIVERED', 'READ']) &&
             data.messageType is string && (data.messageType in ['TEXT', 'AUDIO', 'IMAGE', 'SCREENSHOT']) &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 2000)) &&
             (!('isAssistant' in data) || data.isAssistant is bool) &&
             (!('replyTo' in data) || (data.replyTo is string && data.replyTo.size() <= 64)) &&
             (!('replyToSender' in data) || (data.replyToSender is string && data.replyToSender.size() <= 128)) &&
             (!('replyPreview' in data) || (data.replyPreview is string && data.replyPreview.size() <= 1000)) &&
             !('reactions' in data) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isOwnReactionChange() {
      let before = resource.data.get('reactions', {});
      let after = request.resource.data.get('reactions', {});
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
             after is map && after.size() <= 50 &&
             after.diff(before).affectedKeys().hasOnly([request.auth.uid]) &&
             (!(request.auth.uid in after) ||
              (after[request.auth.uid] is string && after[request.auth.uid].size() <= 300));
    }

    function isValidBlob(data) {
      return data.senderId == request.auth.uid &&
             data.mediaId is string && data.mediaId.size() >= 8 && data.mediaId.size() <= 64 &&
             data.index is int && data.index >= 0 &&
             data.total is int && data.total >= 1 && data.total <= 4 && data.index < data.total &&
             data.data is string && data.data.size() <= 950000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /contacts/{contactUserId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidContact(request.resource.data);
        allow update: if isOwner(userId) && isValidContact(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn() && isValidChat(request.resource.data);
      allow update: if isSignedIn() && request.auth.uid in resource.data.memberUids && isValidChat(request.resource.data);
      allow delete: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids;
        allow create: if isSignedIn() &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids &&
                         isValidChatMessage(request.resource.data);
        allow update: if isSignedIn() &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids &&
                         (resource.data.senderId == request.auth.uid ||
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryStatus']) ||
                          isOwnReactionChange());
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }

      match /blobs/{blobId} {
        allow read, delete: if isChatMember(chatId);
        allow create: if isChatMember(chatId) && isValidBlob(request.resource.data);
      }
    }

    match /app_config/public {
      allow read: if isSignedIn();
      allow write: if isFounder();
    }
    match /app_config/{docId} {
      allow read, write: if isFounder();
    }

    match /push_tokens/{userId} {
      allow create, update: if isOwner(userId) &&
                               request.resource.data.token is string &&
                               request.resource.data.token.size() <= 4096;
      allow delete: if isOwner(userId);
    }
  }
}
